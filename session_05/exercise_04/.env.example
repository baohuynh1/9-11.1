# ===== Thư mục chứa source 4 service (build context) =====
# Mặc định dùng exercise_01 bên cạnh. Nếu build JAR ở ổ Linux của WSL thì đổi, VD: BUILD_ROOT=/home/bao/ex01
BUILD_ROOT=../exercise_01

# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ===== Dùng chung =====
DB_HOST=quickbite-db
DB_PORT=5432

# ===== User =====
USER_DB_NAME=quickbite_user_db
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=changeme
USER_SERVER_PORT=8081

# ===== Restaurant =====
RESTAURANT_DB_NAME=quickbite_restaurant_db
RESTAURANT_DB_USERNAME=postgres
RESTAURANT_DB_PASSWORD=changeme
RESTAURANT_SERVER_PORT=8082

# ===== Order =====
ORDER_DB_NAME=quickbite_order_db
ORDER_DB_USERNAME=postgres
ORDER_DB_PASSWORD=changeme
ORDER_SERVER_PORT=8083

# ===== Notification =====
NOTIFICATION_DB_NAME=quickbite_notification_db
NOTIFICATION_DB_USERNAME=postgres
NOTIFICATION_DB_PASSWORD=changeme
NOTIFICATION_SERVER_PORT=8084
